---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { fetchServices } from "../lib/sheets";

const fetchedServices = await fetchServices();
const services = fetchedServices.filter(
  (s) => s.id.startsWith("SERV-") || s.id.startsWith("PROD-"),
);
const packages = fetchedServices.filter((s) => s.id.startsWith("PAQ-"));
const whatsappNumber = "5213318391094";
---

<Layout
  title="Agendar Cita | InMotus"
  description="Agenda tu sesión de fisioterapia en InMotus Guadalajara."
>
  <Header />
  <main class="min-h-screen relative bg-slate-50 overflow-hidden pt-20 pb-12">
    <!-- Decorative background elements -->
    <div class="absolute inset-0 pointer-events-none z-0 overflow-hidden">
      <div
        class="absolute top-0 -right-20 w-96 h-96 bg-cyan-500/20 rounded-full blur-3xl animate-float"
      >
      </div>
      <div
        class="absolute bottom-1/4 -left-20 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl animate-float-slow"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/4 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl animate-pulse-soft"
      >
      </div>
    </div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-10">
        <h1
          class="text-4xl font-extrabold text-slate-900 tracking-tight sm:text-5xl mb-4"
        >
          Agenda tu Cita
        </h1>
        <p class="text-xl text-slate-600 max-w-2xl mx-auto">
          Completa tus datos y nos pondremos en contacto contigo para confirmar
          tu cita.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        
        <!-- Columna Lateral (Arriba en móvil, derecha en PC) -->
        <div class="lg:col-span-5 xl:col-span-4 lg:order-last flex flex-col gap-6 h-full">
          
          <!-- Alternativa de WhatsApp -->
          <div class="flex-1 bg-green-50/90 backdrop-blur-sm border border-green-200 p-6 sm:p-8 rounded-2xl shadow-lg flex flex-col justify-center gap-5 transition-transform hover:-translate-y-1">
            <div class="flex items-center gap-4 text-left">
              <div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center flex-shrink-0 shadow-md text-white">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-green-950 font-bold text-lg leading-tight">¿Atención personalizada?</h3>
              </div>
            </div>
            <p class="text-green-800 text-sm">Si prefieres verificar disponibilidad con un especialista, consúltalo por WhatsApp.</p>
            <a
              href={`https://wa.me/${whatsappNumber}?text=Hola,%20me%20gustar%C3%ADa%20consultar%20disponibilidad%20para%20una%20cita.`}
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 text-center bg-green-500 hover:bg-green-600 text-white font-bold rounded-xl shadow-md hover:shadow-lg transition-all w-full mt-auto"
            >
              Ir a WhatsApp
            </a>
          </div>

          <!-- Horario informativo (movido a la derecha) -->
          <div class="flex-1 bg-blue-50/90 backdrop-blur-sm border border-blue-200 p-6 sm:p-8 rounded-2xl shadow-lg flex flex-col justify-center gap-4">
            <div class="flex gap-4 text-blue-800 h-full">
              <svg class="w-7 h-7 text-blue-600 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <div class="flex flex-col justify-center">
                <h3 class="font-bold text-lg leading-tight text-blue-950 mb-4">Horario de atención</h3>
                <div class="space-y-3 text-sm">
                  <p>
                    <span class="block font-semibold text-blue-900">Lunes – Viernes:</span>
                    9:00 a.m – 2:00 p.m y 3:00 p.m – 8:00 p.m <br>
                    <span class="text-xs opacity-75">(última cita 7:00 p.m)</span>
                  </p>
                  <p>
                    <span class="block font-semibold text-blue-900">Sábado:</span>
                    9:00 a.m – 2:00 p.m <br>
                    <span class="text-xs opacity-75">(última cita 1:00 p.m)</span>
                  </p>
                  <p>
                    <span class="block font-semibold text-blue-900">Domingo:</span>
                    Cerrado
                  </p>
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- Formulario Principal -->
        <div
          class="lg:col-span-7 xl:col-span-8 lg:order-first bg-white p-6 sm:p-8 rounded-2xl shadow-xl border border-slate-200 h-full flex flex-col"
        >
          <h2 class="text-2xl font-bold text-slate-800 mb-6">
            Detalles de tu Cita
          </h2>
          
          <form id="booking-form" class="space-y-5 flex-1 flex flex-col">
            <!-- Nombre del Paciente -->
            <div class="relative group">
              <input
                type="text"
                id="name"
                name="name"
                required
                class="peer w-full h-[54px] px-4 py-3 rounded-lg border border-slate-300 focus:border-blue-900 focus:ring-4 focus:ring-blue-100 outline-none transition-all placeholder-transparent text-base text-slate-800 bg-white box-border m-0"
                placeholder="Nombre completo"
              />
              <label
                for="name"
                class="absolute left-4 top-3.5 text-slate-500 text-base transition-all pointer-events-none font-medium
                       peer-focus:-top-2.5 peer-focus:left-2 peer-focus:text-xs peer-focus:text-blue-950 peer-focus:bg-white peer-focus:px-1
                       peer-[:not(:placeholder-shown)]:-top-2.5 peer-[:not(:placeholder-shown)]:left-2 peer-[:not(:placeholder-shown)]:text-xs peer-[:not(:placeholder-shown)]:bg-white peer-[:not(:placeholder-shown)]:px-1 peer-[:not(:placeholder-shown)]:text-blue-950 peer-[:not(:placeholder-shown)]:font-bold"
              >
                Nombre completo
              </label>
            </div>

            <!-- Correo Electrónico -->
            <div class="relative group">
              <input
                type="email"
                id="email"
                name="email"
                required
                class="peer w-full h-[54px] px-4 py-3 rounded-lg border border-slate-300 focus:border-blue-900 focus:ring-4 focus:ring-blue-100 outline-none transition-all placeholder-transparent text-base text-slate-800 bg-white box-border m-0"
                placeholder="Correo Electrónico"
              />
              <label
                for="email"
                class="absolute left-4 top-3.5 text-slate-500 text-base transition-all pointer-events-none font-medium
                       peer-focus:-top-2.5 peer-focus:left-2 peer-focus:text-xs peer-focus:text-blue-950 peer-focus:bg-white peer-focus:px-1
                       peer-[:not(:placeholder-shown)]:-top-2.5 peer-[:not(:placeholder-shown)]:left-2 peer-[:not(:placeholder-shown)]:text-xs peer-[:not(:placeholder-shown)]:bg-white peer-[:not(:placeholder-shown)]:px-1 peer-[:not(:placeholder-shown)]:text-blue-950 peer-[:not(:placeholder-shown)]:font-bold"
              >
                Correo Electrónico
              </label>
            </div>

            <!-- Teléfono -->
            <div class="relative group">
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                pattern="[0-9]{10}"
                class="peer w-full h-[54px] px-4 py-3 rounded-lg border border-slate-300 focus:border-blue-900 focus:ring-4 focus:ring-blue-100 outline-none transition-all placeholder-transparent text-base text-slate-800 bg-white box-border m-0"
                placeholder="Teléfono (10 dígitos)"
              />
              <label
                for="phone"
                class="absolute left-4 top-3.5 text-slate-500 text-base transition-all pointer-events-none font-medium
                       peer-focus:-top-2.5 peer-focus:left-2 peer-focus:text-xs peer-focus:text-blue-950 peer-focus:bg-white peer-focus:px-1
                       peer-[:not(:placeholder-shown)]:-top-2.5 peer-[:not(:placeholder-shown)]:left-2 peer-[:not(:placeholder-shown)]:text-xs peer-[:not(:placeholder-shown)]:bg-white peer-[:not(:placeholder-shown)]:px-1 peer-[:not(:placeholder-shown)]:text-blue-950 peer-[:not(:placeholder-shown)]:font-bold"
              >
                Teléfono (10 dígitos)
              </label>
            </div>

            <div class="relative group">
              <select
                id="service"
                name="service"
                class="peer w-full h-[54px] px-3 sm:px-4 py-3 rounded-lg border border-slate-300 focus:border-blue-900 focus:ring-4 focus:ring-blue-100 outline-none transition-all appearance-none bg-white text-base text-slate-800 box-border m-0"
              >
                {
                  services.length > 0 && (
                    <optgroup label="Servicios">
                      {services.map((s) => (
                        <option value={s.title}>
                          {s.title} - ${s.price} MXN
                        </option>
                      ))}
                    </optgroup>
                  )
                }
                {
                  packages.length > 0 && (
                    <optgroup label="Paquetes">
                      {packages.map((s) => (
                        <option value={s.title}>
                          {s.title} - ${s.price} MXN
                        </option>
                      ))}
                    </optgroup>
                  )
                }
                {
                  fetchedServices.length === 0 && (
                    <option value="Consulta General">
                      Consulta General - $500 MXN
                    </option>
                  )
                }
              </select>
              <label
                for="service"
                class="absolute -top-2.5 left-2 text-xs text-blue-950 bg-white px-1 font-bold transition-all z-10"
              >
                Seleccionar Servicio
              </label>
              <!-- Icono de flechita para el select -->
              <div
                class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400"
              >
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
            </div>



            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div class="relative group min-w-0">
                <input
                  type="date"
                  id="date"
                  name="date"
                  required
                  class="peer w-full h-[54px] px-3 sm:px-4 py-3 sm:py-3.5 rounded-lg border border-slate-300 focus:border-blue-900 focus:ring-4 focus:ring-blue-100 outline-none transition-all text-base text-slate-800 bg-white box-border appearance-none m-0"
                />
                <label
                  for="date"
                  class="absolute -top-2.5 left-2 text-[10px] sm:text-xs text-blue-950 bg-white px-1 font-bold z-10"
                >
                  Día de Preferencia
                </label>
                <p
                  id="date-warning"
                  class="hidden mt-2 text-xs text-red-600 font-medium"
                >
                  Los domingos estamos cerrados. Por favor elige otro día.
                </p>
              </div>

              <div class="relative group min-w-0">
                <select
                  id="time"
                  name="time"
                  required
                  class="peer w-full h-[54px] px-3 sm:px-4 py-3 sm:py-3.5 rounded-lg border border-slate-300 focus:border-blue-900 focus:ring-4 focus:ring-blue-100 outline-none transition-all appearance-none bg-white text-base text-slate-800 box-border m-0"
                >
                  <option value="" disabled selected>Hora de Preferencia</option
                  >
                </select>
                <label
                  for="time"
                  class="absolute -top-2.5 left-2 text-[10px] sm:text-xs text-blue-950 bg-white px-1 font-bold z-10"
                >
                  Hora
                </label>
                <div
                  class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"></path>
                  </svg>
                </div>
              </div>
            </div>

            <div class="pt-6 mt-auto">
              <button
                type="submit"
                id="submit-btn"
                class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-blue-950 to-blue-900 hover:from-blue-900 hover:to-slate-800 text-white font-bold text-lg shadow-lg transition-all transform hover:scale-[1.01] active:scale-[0.98]"
              >
                Solicitar Cita
              </button>
            </div>
          </form>

          <div
            id="success-msg"
            class="hidden mt-6 p-4 bg-green-50 border border-green-200 rounded-xl text-center"
          >
            <p class="text-green-800 font-bold text-lg">
              ¡Solicitud enviada correctamente!
            </p>
            <p class="text-green-600">
              Nos pondremos en contacto contigo muy pronto para confirmar disponibilidad de tu cita.
            </p>
          </div>
        </div>

      </div>
    </div>
  </main>
</Layout>

<script define:vars={{ whatsappNumber }}>
  const form = document.getElementById("booking-form");
  const btn = document.getElementById("submit-btn");
  const successMsg = document.getElementById("success-msg");
  const serviceSelect = document.getElementById("service");
  const dateInput = document.getElementById("date");
  const timeSelect = document.getElementById("time");
  const dateWarning = document.getElementById("date-warning");
  const WEBHOOK_URL = "https://workflow.inmotus.mx/webhook/agendawebinmotus";
  // TODO: reemplaza esta URL con tu webhook GET de disponibilidad en n8n
  const AVAILABILITY_URL =
    "https://workflow.inmotus.mx/webhook/disponibilidad-inmotus";
  const AUTH = "d2ViYWdlbmRhOkYxczEwaW5tb3R1c18xMA==";

  // Horas base según día
  function getHours(dayOfWeek) {
    if (dayOfWeek === 0) return [];
    // Lunes a Sábado: 11 am a 5 pm
    return [11, 12, 13, 14, 15, 16, 17];
  }

  function formatHour(h) {
    const suffix = h < 12 ? "am" : "pm";
    const display = h > 12 ? h - 12 : h;
    return `${display}:00 ${suffix}`;
  }

  // Consulta citas ocupadas para una fecha. Retorna Set<number> de horas bloqueadas,
  // o null si el webhook no responde (en cuyo caso se muestran todos los slots).
  async function fetchBlockedHours(dateStr) {
    try {
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 5000);
      const res = await fetch(`${AVAILABILITY_URL}?date=${dateStr}`, {
        signal: controller.signal,
      });
      clearTimeout(timeout);
      if (!res.ok) return null;

      let raw;
      try {
        raw = await res.json();
      } catch {
        return null;
      }

      // n8n puede devolver array plano o envuelto en { json: { ... } }
      const appts = Array.isArray(raw) ? raw : raw ? [raw] : [];
      const blocked = new Set();
      for (const appt of appts) {
        // Soportar formato n8n ({ json: { start_time } }) y plano ({ start_time })
        const row = appt?.json ?? appt ?? {};
        const t = row.start_time || row.startTime || "";
        const hStr = String(t).split(":")[0];
        const h = parseInt(hStr, 10);
        if (!isNaN(h)) blocked.add(h);
      }
      return blocked;
    } catch {
      return null; // red caída, timeout u otro error → fallback silencioso
    }
  }

  function renderHours(hours, blockedSet, isToday, currentHour) {
    timeSelect.innerHTML = "";
    const placeholder = document.createElement("option");
    placeholder.value = "";
    placeholder.textContent = "Selecciona una hora";
    timeSelect.appendChild(placeholder);

    for (const h of hours) {
      if (blockedSet && blockedSet.has(h)) continue; // ocupada → omitir
      if (isToday && h <= currentHour) continue; // hora ya pasó → omitir
      
      const opt = document.createElement("option");
      opt.value = `${String(h).padStart(2, "0")}:00`;
      opt.textContent = formatHour(h);
      timeSelect.appendChild(opt);
    }

    if (timeSelect.options.length === 1) {
      // Solo el placeholder → no hay horas disponibles
      placeholder.textContent = "Sin horarios disponibles este día";
    }
  }

  async function updateTimeOptions() {
    const val = dateInput.value;
    timeSelect.innerHTML = "";

    if (!val) {
      timeSelect.innerHTML = '<option value="">Elige un día primero</option>';
      dateWarning.classList.add("hidden");
      return;
    }

    const [y, m, d] = val.split("-").map(Number);
    const dt = new Date(y, m - 1, d);
    const day = dt.getDay();

    if (day === 0) {
      dateInput.value = "";
      timeSelect.innerHTML = '<option value="">Elige un día primero</option>';
      dateWarning.classList.remove("hidden");
      return;
    }

    dateWarning.classList.add("hidden");
    const hours = getHours(day);

    // Estado de carga
    timeSelect.innerHTML =
      '<option value="">Consultando disponibilidad…</option>';
    timeSelect.disabled = true;

    const blocked = await fetchBlockedHours(val); // null = webhook sin respuesta
    timeSelect.disabled = false;
    
    // Verificar si es el día actual para bloquear horas pasadas
    const now = new Date();
    const isToday = y === now.getFullYear() && (m - 1) === now.getMonth() && d === now.getDate();
    const currentHour = now.getHours();

    renderHours(hours, blocked, isToday, currentHour); // si blocked es null, muestra todos los slots
  }

  // Bloquear fechas pasadas
  const today = new Date();
  const yyyy = today.getFullYear();
  const mm = String(today.getMonth() + 1).padStart(2, "0");
  const dd = String(today.getDate()).padStart(2, "0");
  dateInput.min = `${yyyy}-${mm}-${dd}`;

  dateInput.addEventListener("change", updateTimeOptions);

  // Pre-seleccionar servicio desde la URL
  const params = new URLSearchParams(window.location.search);
  const selectedService = params.get("service");
  if (selectedService && serviceSelect) {
    const options = Array.from(serviceSelect.options);
    const found = options.find((opt) => opt.value === selectedService);
    if (found) serviceSelect.value = selectedService;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    if (!data.time) {
      alert("Por favor selecciona una hora de preferencia.");
      return;
    }

    const [year, month, dayStr] = data.date.split("-").map(Number);
    const [hours] = data.time.split(":").map(Number);
    const dt = new Date(year, month - 1, dayStr, hours);
    const day = dt.getDay();
    const hr = dt.getHours();

    let isAllowed = false;
    if (day >= 1 && day <= 6) isAllowed = hr >= 11 && hr <= 17;

    if (!isAllowed) {
      alert(
        "Lo sentimos, ese horario está fuera de nuestro horario laboral.\nLun-Vie: 9:00 am – 8:00 pm (última cita 7:00 pm)\nSáb: 9:00 am – 2:00 pm (última cita 1:00 pm)\nDomingos: Cerrado",
      );
      return;
    }

    btn.disabled = true;
    btn.innerText = "Enviando...";

    try {
      const auth = "d2ViYWdlbmRhOkYxczEwaW5tb3R1c18xMA==";
      await fetch(WEBHOOK_URL, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Basic ${auth}`,
        },
        body: JSON.stringify({ ...data, type: "solicitud_web" }),
      });
      form.classList.add("hidden");
      successMsg.classList.remove("hidden");
    } catch (err) {
      console.error(err);
      alert("Hubo un error al enviar tu solicitud. Intenta de nuevo.");
      btn.disabled = false;
      btn.innerText = "Solicitar Cita";
    }
  });
</script>
