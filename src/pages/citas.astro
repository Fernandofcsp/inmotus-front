---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { fetchServices } from "../lib/sheets";

const fetchedServices = await fetchServices();
const whatsappNumber = "523318391094";
---

<Layout title="Agendar Cita | INMOTUS">
  <Header />
  <main class="min-h-screen bg-transparent pt-20 pb-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h1
          class="text-4xl font-extrabold text-slate-900 tracking-tight sm:text-5xl mb-4"
        >
          Agenda tu Cita
        </h1>
        <p class="text-xl text-slate-600 max-w-2xl mx-auto">
          Completa tus datos y nos pondremos en contacto contigo para confirmar
          la disponibilidad.
        </p>
      </div>

      <div class="max-w-2xl mx-auto">
        <div
          class="bg-white p-6 sm:p-8 rounded-2xl shadow-xl border border-slate-200"
        >
          <h2 class="text-2xl font-bold text-slate-800 mb-6">
            Detalles de tu Cita
          </h2>

          <form id="booking-form" class="space-y-5">
            <div>
              <label
                for="name"
                class="block text-sm font-medium text-slate-700 mb-1"
                >Nombre Completo</label
              >
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-900 outline-none transition-all"
                placeholder="Juan Pérez"
              />
            </div>

            <div>
              <label
                for="email"
                class="block text-sm font-medium text-slate-700 mb-1"
                >Correo Electrónico</label
              >
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-900 outline-none transition-all"
                placeholder="tu@correo.com"
              />
            </div>

            <div>
              <label
                for="phone"
                class="block text-sm font-medium text-slate-700 mb-1"
                >Teléfono (WhatsApp)</label
              >
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-900 outline-none transition-all"
                placeholder="Ej: 33 1234 5678"
              />
            </div>

            <div>
              <label
                for="service"
                class="block text-sm font-medium text-slate-700 mb-1"
                >Servicio</label
              >
              <select
                id="service"
                name="service"
                class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-900 outline-none transition-all"
              >
                {
                  fetchedServices.map((s) => (
                    <option value={s.title}>
                      {s.title} - ${s.price} MXN
                    </option>
                  ))
                }
                {
                  fetchedServices.length === 0 && (
                    <option value="Consulta General">
                      Consulta General - $500 MXN
                    </option>
                  )
                }
              </select>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label
                  for="date"
                  class="block text-sm font-medium text-slate-700 mb-1"
                  >Día de Preferencia</label
                >
                <input
                  type="date"
                  id="date"
                  name="date"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-900 outline-none transition-all"
                />
              </div>
              <div>
                <label
                  for="time"
                  class="block text-sm font-medium text-slate-700 mb-1"
                  >Hora de Preferencia</label
                >
                <input
                  type="time"
                  id="time"
                  name="time"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-900 outline-none transition-all"
                />
              </div>
            </div>

            <div class="pt-4">
              <button
                type="submit"
                id="submit-btn"
                class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-blue-950 to-blue-900 hover:from-blue-900 hover:to-slate-800 text-white font-bold text-lg shadow-lg transition-all transform hover:scale-[1.01]"
              >
                Solicitar Cita
              </button>
            </div>
          </form>

          <div
            id="success-msg"
            class="hidden mt-6 p-4 bg-green-50 border border-green-200 rounded-xl text-center"
          >
            <p class="text-green-800 font-bold text-lg">
              ¡Solicitud enviada correctamente!
            </p>
            <p class="text-green-600">
              Nos pondremos en contacto contigo muy pronto.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script define:vars={{ whatsappNumber }}>
  const form = document.getElementById("booking-form");
  const btn = document.getElementById("submit-btn");
  const successMsg = document.getElementById("success-msg");
  const serviceSelect = document.getElementById("service");
  const WEBHOOK_URL = "https://special-automated-corps-minerals.trycloudflare.com/webhook/agendawebinmotus";

  // Pre-seleccionar servicio desde la URL
  const params = new URLSearchParams(window.location.search);
  const selectedService = params.get("service");
  if (selectedService && serviceSelect) {
    const options = Array.from(serviceSelect.options);
    const found = options.find((opt) => opt.value === selectedService);
    if (found) {
      serviceSelect.value = selectedService;
    }
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    // Validación de horario
    // Lunes-Viernes: 9-7 (9:00 - 19:00)
    // Sábado: 9-1 (9:00 - 13:00)
    // Domingo: Cerrado
    const [year, month, dayStr] = data.date.split("-").map(Number);
    const [hours, minutes] = data.time.split(":").map(Number);
    const dt = new Date(year, month - 1, dayStr, hours, minutes);

    const day = dt.getDay(); // 0 = Domingo, 1-5 = Lun-Vie, 6 = Sábado
    const hr = dt.getHours();

    let isAllowed = false;
    if (day >= 1 && day <= 5) {
      // Lun-Vie 9am-7pm
      isAllowed = hr >= 9 && hr < 19;
    } else if (day === 6) {
      // Sab 9am-1pm
      isAllowed = hr >= 9 && hr < 13;
    }

    if (!isAllowed) {
      alert(
        "Lo sentimos, el horario elegido está fuera de nuestro horario laboral (Lun-Vie 9:00-19:00 y Sáb 9:00-13:00). Domingos estamos cerrados.",
      );
      return;
    }

    btn.disabled = true;
    btn.innerText = "Enviando...";

    try {
      const auth = "d2ViYWdlbmRhOkYxczEwaW5tb3R1c18xMA==";

      await fetch(WEBHOOK_URL, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Basic ${auth}`,
        },
        body: JSON.stringify({ ...data, type: "solicitud_web" }),
      });

      // Mostrar éxito
      form.classList.add("hidden");
      successMsg.classList.remove("hidden");
    } catch (err) {
      console.error(err);
      alert("Hubo un error al enviar tu solicitud. Intenta de nuevo.");
      btn.disabled = false;
      btn.innerText = "Solicitar Cita";
    }
  });
</script>
