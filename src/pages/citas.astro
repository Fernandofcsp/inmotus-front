---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { fetchServices } from "../lib/sheets";

const fetchedServices = await fetchServices();
const whatsappNumber = "523318391094";
---

<Layout
  title="Agendar Cita | InMotus"
  description="Agenda tu sesión de fisioterapia en InMotus Guadalajara."
>
  <Header />
  <main class="min-h-screen relative bg-slate-50 overflow-hidden pt-20 pb-12">
    <!-- Decorative background elements -->
    <div class="absolute inset-0 pointer-events-none z-0 overflow-hidden">
      <div
        class="absolute top-0 -right-20 w-96 h-96 bg-cyan-500/20 rounded-full blur-3xl animate-float"
      >
      </div>
      <div
        class="absolute bottom-1/4 -left-20 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl animate-float-slow"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/4 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl animate-pulse-soft"
      >
      </div>
    </div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-10">
        <h1
          class="text-4xl font-extrabold text-slate-900 tracking-tight sm:text-5xl mb-4"
        >
          Agenda tu Cita
        </h1>
        <p class="text-xl text-slate-600 max-w-2xl mx-auto">
          Completa tus datos y nos pondremos en contacto contigo para confirmar
          la disponibilidad.
        </p>
      </div>

      <div class="max-w-2xl mx-auto">
        <div
          class="bg-white p-6 sm:p-8 rounded-2xl shadow-xl border border-slate-200"
        >
          <h2 class="text-2xl font-bold text-slate-800 mb-6">
            Detalles de tu Cita
          </h2>

          <form id="booking-form" class="space-y-5">
            <!-- Nombre del Paciente -->
            <div class="relative group">
              <input
                type="text"
                id="name"
                name="name"
                required
                class="peer w-full px-4 py-3 rounded-lg border border-slate-300 focus:border-blue-900 focus:ring-4 focus:ring-blue-100 outline-none transition-all placeholder-transparent"
                placeholder="Nombre"
              />
              <label
                for="name"
                class="absolute left-4 top-3 text-slate-500 text-base transition-all pointer-events-none
                       peer-focus:-top-2.5 peer-focus:left-2 peer-focus:text-xs peer-focus:text-blue-900 peer-focus:bg-white peer-focus:px-1
                       peer-[:not(:placeholder-shown)]:-top-2.5 peer-[:not(:placeholder-shown)]:left-2 peer-[:not(:placeholder-shown)]:text-xs peer-[:not(:placeholder-shown)]:bg-white peer-[:not(:placeholder-shown)]:px-1"
              >
                Nombre del Paciente
              </label>
            </div>

            <!-- Correo Electrónico -->
            <div class="relative group">
              <input
                type="email"
                id="email"
                name="email"
                required
                class="peer w-full px-4 py-3 rounded-lg border border-slate-300 focus:border-blue-900 focus:ring-4 focus:ring-blue-100 outline-none transition-all placeholder-transparent"
                placeholder="Correo"
              />
              <label
                for="email"
                class="absolute left-4 top-3 text-slate-500 text-base transition-all pointer-events-none
                       peer-focus:-top-2.5 peer-focus:left-2 peer-focus:text-xs peer-focus:text-blue-900 peer-focus:bg-white peer-focus:px-1
                       peer-[:not(:placeholder-shown)]:-top-2.5 peer-[:not(:placeholder-shown)]:left-2 peer-[:not(:placeholder-shown)]:text-xs peer-[:not(:placeholder-shown)]:bg-white peer-[:not(:placeholder-shown)]:px-1"
              >
                Correo Electrónico
              </label>
            </div>

            <!-- Teléfono -->
            <div class="relative group">
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                class="peer w-full px-4 py-3 rounded-lg border border-slate-300 focus:border-blue-900 focus:ring-4 focus:ring-blue-100 outline-none transition-all placeholder-transparent"
                placeholder="Teléfono"
              />
              <label
                for="phone"
                class="absolute left-4 top-3 text-slate-500 text-base transition-all pointer-events-none
                       peer-focus:-top-2.5 peer-focus:left-2 peer-focus:text-xs peer-focus:text-blue-900 peer-focus:bg-white peer-focus:px-1
                       peer-[:not(:placeholder-shown)]:-top-2.5 peer-[:not(:placeholder-shown)]:left-2 peer-[:not(:placeholder-shown)]:text-xs peer-[:not(:placeholder-shown)]:bg-white peer-[:not(:placeholder-shown)]:px-1"
              >
                Teléfono (WhatsApp) a 10 dígitos
              </label>
            </div>

            <div class="relative group">
              <select
                id="service"
                name="service"
                class="peer w-full px-4 py-3 rounded-lg border border-slate-300 focus:border-blue-900 focus:ring-4 focus:ring-blue-100 outline-none transition-all appearance-none bg-white"
              >
                {
                  fetchedServices.map((s) => (
                    <option value={s.title}>
                      {s.title} - ${s.price} MXN
                    </option>
                  ))
                }
                {
                  fetchedServices.length === 0 && (
                    <option value="Consulta General">
                      Consulta General - $500 MXN
                    </option>
                  )
                }
              </select>
              <label
                for="service"
                class="absolute -top-2.5 left-2 text-xs text-blue-900 bg-white px-1 transition-all"
              >
                Seleccionar Servicio
              </label>
              <!-- Icono de flechita para el select -->
              <div
                class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400"
              >
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
            </div>

            <!-- Horario informativo -->
            <div
              class="rounded-xl bg-blue-50 border border-blue-100 p-4 flex gap-3"
            >
              <svg
                class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <div class="text-sm text-blue-800">
                <p class="font-semibold mb-1">Horario de atención</p>
                <p>
                  Lunes – Viernes: <span class="font-medium"
                    >9:00 a.m – 2:00 p.m y 3:00 p.m – 8:00 p.m</span
                  > (última cita 7:00 p.m)
                </p>
                <p>
                  Sábado: <span class="font-medium">9:00 a.m – 2:00 p.m</span> (última
                  cita 1:00 p.m)
                </p>
                <p>Domingo: <span class="font-medium">Cerrado</span></p>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div class="relative group">
                <input
                  type="date"
                  id="date"
                  name="date"
                  required
                  class="peer w-full px-4 py-3.5 rounded-lg border border-slate-300 focus:border-blue-900 focus:ring-4 focus:ring-blue-100 outline-none transition-all text-slate-800 bg-white"
                />
                <label
                  for="date"
                  class="absolute -top-2.5 left-2 text-xs text-blue-900 bg-white px-1 font-medium"
                >
                  Día de Preferencia
                </label>
                <p id="date-warning" class="hidden mt-2 text-xs text-red-600">
                  Los domingos estamos cerrados. Por favor elige otro día.
                </p>
              </div>

              <div class="relative group">
                <select
                  id="time"
                  name="time"
                  required
                  class="peer w-full px-4 py-3.5 rounded-lg border border-slate-300 focus:border-blue-900 focus:ring-4 focus:ring-blue-100 outline-none transition-all appearance-none bg-white"
                >
                  <option value="" disabled selected>Hora de Preferencia</option
                  >
                </select>
                <label
                  for="time"
                  class="absolute -top-2.5 left-2 text-xs text-blue-900 bg-white px-1 font-medium"
                >
                  Hora
                </label>
                <div
                  class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"></path>
                  </svg>
                </div>
              </div>
            </div>

            <div class="pt-6">
              <button
                type="submit"
                id="submit-btn"
                class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-blue-950 to-blue-900 hover:from-blue-900 hover:to-slate-800 text-white font-bold text-lg shadow-lg transition-all transform hover:scale-[1.01] active:scale-[0.98]"
              >
                Solicitar Cita
              </button>
            </div>
          </form>

          <div
            id="success-msg"
            class="hidden mt-6 p-4 bg-green-50 border border-green-200 rounded-xl text-center"
          >
            <p class="text-green-800 font-bold text-lg">
              ¡Solicitud enviada correctamente!
            </p>
            <p class="text-green-600">
              Nos pondremos en contacto contigo muy pronto.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script define:vars={{ whatsappNumber }}>
  const form = document.getElementById("booking-form");
  const btn = document.getElementById("submit-btn");
  const successMsg = document.getElementById("success-msg");
  const serviceSelect = document.getElementById("service");
  const dateInput = document.getElementById("date");
  const timeSelect = document.getElementById("time");
  const dateWarning = document.getElementById("date-warning");
  const WEBHOOK_URL = "https://workflow.inmotus.mx/webhook/agendawebinmotus";
  // TODO: reemplaza esta URL con tu webhook GET de disponibilidad en n8n
  const AVAILABILITY_URL =
    "https://workflow.inmotus.mx/webhook/disponibilidad-inmotus";
  const AUTH = "d2ViYWdlbmRhOkYxczEwaW5tb3R1c18xMA==";

  // Horas base según día
  function getHours(dayOfWeek) {
    if (dayOfWeek === 0) return [];
    if (dayOfWeek === 6) return [9, 10, 11, 12, 13];
    // Lun-Vie (sin 14:00 por horario de comida)
    return [9, 10, 11, 12, 13, 15, 16, 17, 18, 19];
  }

  function formatHour(h) {
    const suffix = h < 12 ? "am" : "pm";
    const display = h > 12 ? h - 12 : h;
    return `${display}:00 ${suffix}`;
  }

  // Consulta citas ocupadas para una fecha. Retorna Set<number> de horas bloqueadas,
  // o null si el webhook no responde (en cuyo caso se muestran todos los slots).
  async function fetchBlockedHours(dateStr) {
    try {
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 5000);
      const res = await fetch(`${AVAILABILITY_URL}?date=${dateStr}`, {
        signal: controller.signal,
      });
      clearTimeout(timeout);
      if (!res.ok) return null;

      let raw;
      try {
        raw = await res.json();
      } catch {
        return null;
      }

      // n8n puede devolver array plano o envuelto en { json: { ... } }
      const appts = Array.isArray(raw) ? raw : raw ? [raw] : [];
      const blocked = new Set();
      for (const appt of appts) {
        // Soportar formato n8n ({ json: { start_time } }) y plano ({ start_time })
        const row = appt?.json ?? appt ?? {};
        const t = row.start_time || row.startTime || "";
        const hStr = String(t).split(":")[0];
        const h = parseInt(hStr, 10);
        if (!isNaN(h)) blocked.add(h);
      }
      return blocked;
    } catch {
      return null; // red caída, timeout u otro error → fallback silencioso
    }
  }

  function renderHours(hours, blockedSet) {
    timeSelect.innerHTML = "";
    const placeholder = document.createElement("option");
    placeholder.value = "";
    placeholder.textContent = "Selecciona una hora";
    timeSelect.appendChild(placeholder);

    for (const h of hours) {
      if (blockedSet && blockedSet.has(h)) continue; // ocupada → omitir
      const opt = document.createElement("option");
      opt.value = `${String(h).padStart(2, "0")}:00`;
      opt.textContent = formatHour(h);
      timeSelect.appendChild(opt);
    }

    if (timeSelect.options.length === 1) {
      // Solo el placeholder → no hay horas disponibles
      placeholder.textContent = "Sin horarios disponibles este día";
    }
  }

  async function updateTimeOptions() {
    const val = dateInput.value;
    timeSelect.innerHTML = "";

    if (!val) {
      timeSelect.innerHTML = '<option value="">Elige un día primero</option>';
      dateWarning.classList.add("hidden");
      return;
    }

    const [y, m, d] = val.split("-").map(Number);
    const dt = new Date(y, m - 1, d);
    const day = dt.getDay();

    if (day === 0) {
      dateInput.value = "";
      timeSelect.innerHTML = '<option value="">Elige un día primero</option>';
      dateWarning.classList.remove("hidden");
      return;
    }

    dateWarning.classList.add("hidden");
    const hours = getHours(day);

    // Estado de carga
    timeSelect.innerHTML =
      '<option value="">Consultando disponibilidad…</option>';
    timeSelect.disabled = true;

    const blocked = await fetchBlockedHours(val); // null = webhook sin respuesta
    timeSelect.disabled = false;
    renderHours(hours, blocked); // si blocked es null, muestra todos los slots
  }

  // Bloquear fechas pasadas
  const today = new Date();
  const yyyy = today.getFullYear();
  const mm = String(today.getMonth() + 1).padStart(2, "0");
  const dd = String(today.getDate()).padStart(2, "0");
  dateInput.min = `${yyyy}-${mm}-${dd}`;

  dateInput.addEventListener("change", updateTimeOptions);

  // Pre-seleccionar servicio desde la URL
  const params = new URLSearchParams(window.location.search);
  const selectedService = params.get("service");
  if (selectedService && serviceSelect) {
    const options = Array.from(serviceSelect.options);
    const found = options.find((opt) => opt.value === selectedService);
    if (found) serviceSelect.value = selectedService;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    if (!data.time) {
      alert("Por favor selecciona una hora de preferencia.");
      return;
    }

    const [year, month, dayStr] = data.date.split("-").map(Number);
    const [hours] = data.time.split(":").map(Number);
    const dt = new Date(year, month - 1, dayStr, hours);
    const day = dt.getDay();
    const hr = dt.getHours();

    let isAllowed = false;
    if (day >= 1 && day <= 5) isAllowed = hr >= 9 && hr <= 19;
    else if (day === 6) isAllowed = hr >= 9 && hr <= 13;

    if (!isAllowed) {
      alert(
        "Lo sentimos, ese horario está fuera de nuestro horario laboral.\nLun-Vie: 9:00 am – 8:00 pm (última cita 7:00 pm)\nSáb: 9:00 am – 2:00 pm (última cita 1:00 pm)\nDomingos: Cerrado",
      );
      return;
    }

    btn.disabled = true;
    btn.innerText = "Enviando...";

    try {
      const auth = "d2ViYWdlbmRhOkYxczEwaW5tb3R1c18xMA==";
      await fetch(WEBHOOK_URL, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Basic ${auth}`,
        },
        body: JSON.stringify({ ...data, type: "solicitud_web" }),
      });
      form.classList.add("hidden");
      successMsg.classList.remove("hidden");
    } catch (err) {
      console.error(err);
      alert("Hubo un error al enviar tu solicitud. Intenta de nuevo.");
      btn.disabled = false;
      btn.innerText = "Solicitar Cita";
    }
  });
</script>
