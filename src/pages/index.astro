---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Packages from "../components/Packages.astro";
import Physiotherapists from "../components/Physiotherapists.astro";
import Testimonials from "../components/Testimonials.astro";
import FAQ from "../components/FAQ.astro";
import Gallery from "../components/Gallery.astro";
import Typewriter from "../components/Typewriter";
import OrbitBorderButton from "../components/OrbitBorderButton";

const whatsappNumber = "5213318391094";

const formatPhoneNumber = (num: string) => {
  const cleaned = num.replace(/\D/g, "");
  if (cleaned.length === 12) {
    return `+${cleaned.slice(0, 2)} ${cleaned.slice(2, 4)} ${cleaned.slice(4, 8)} ${cleaned.slice(8)}`;
  }
  return num;
};
---

<Layout
  title="InMotus | Fisioterapia Especializada en Guadalajara | Rehabilitación Física"
  description="Recupera tu movimiento con los mejores fisioterapeutas en Guadalajara. Especialistas en rehabilitación física, deportiva y geriátrica en Jardines de la Cruz."
>
  <Header />
  <main class="relative">
    <!-- Hero Section -->
    <section
      class="relative flex items-center overflow-hidden pt-6 pb-6 sm:pt-10 sm:pb-10 lg:pt-14 lg:pb-12"
    >
      <!-- Decorative background elements -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div
          class="absolute top-20 -left-40 w-96 h-96 bg-cyan-500/20 rounded-full blur-3xl animate-float"
        >
        </div>
        <div
          class="absolute bottom-20 -right-40 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl animate-float-slow"
        >
        </div>
        <div
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl animate-pulse-soft"
        >
        </div>
      </div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-0 lg:py-0">
        <div class="grid lg:grid-cols-2 gap-6 lg:gap-10 items-center">
          <!-- Content -->
          <div
            class="text-center lg:text-left space-y-5 sm:space-y-8"
            data-animate="left"
          >
            <h1
              class="text-4xl sm:text-6xl lg:text-7xl font-bold leading-tight text-slate-900 min-h-[2.5em]"
            >
              <Typewriter
                client:load
                className="bg-gradient-to-r from-blue-950 via-blue-900 to-slate-800 bg-clip-text text-transparent"
              /><span
                class="typewriter-cursor bg-gradient-to-b from-blue-950 to-blue-800"
              ></span>
            </h1>
            <p
              class="text-xl sm:text-2xl text-slate-600 max-w-2xl mx-auto lg:mx-0"
              data-animate="up"
              data-delay="150"
            >
              Fisioterapia especializada y personalizada para ayudarte a volver
              a lo que más amas.
            </p>
            <div
              class="flex flex-col sm:flex-row gap-4 items-center justify-center lg:justify-start"
              data-animate="up"
              data-delay="280"
            >
              <OrbitBorderButton
                client:load
                label="Agendar Cita"
                link={`${import.meta.env.BASE_URL}citas`}
                newTab={false}
                fill="linear-gradient(to right, #172554, #1e3a8a)"
                hoverFill="linear-gradient(to right, #1e3a8a, #1e293b)"
                textColor="#ffffff"
                stroke={{
                  color: "#60a5fa",
                  size: 28,
                  speed: 45,
                  direction: "ccw",
                  hoverFill: 100,
                }}
                border={{
                  borderColor: "rgba(30, 58, 138, 0.4)",
                  borderWidth: 2,
                }}
                padding="16px 32px"
                rounded={100}
                hoverScale={105}
                className="w-full sm:w-auto group shadow-lg shadow-blue-900/25 hover:shadow-blue-900/40 transition-shadow"
              >
                <span class="flex items-center justify-center gap-2 w-full">
                  Agendar Cita
                  <svg
                    class="w-5 h-5 group-hover:scale-110 transition-transform"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                    ></path>
                  </svg>
                </span>
              </OrbitBorderButton>
              <OrbitBorderButton
                client:load
                label="Ver Servicios"
                link="#servicios"
                newTab={false}
                fill="rgba(255, 255, 255, 0.5)"
                hoverFill="rgba(248, 250, 252, 0.85)"
                faceStyle={{
                  backdropFilter: "blur(8px)",
                  WebkitBackdropFilter: "blur(8px)",
                }}
                textColor="#0f172a"
                stroke={{
                  color: "#1e3a8a",
                  size: 28,
                  speed: 45,
                  direction: "ccw",
                  hoverFill: 100,
                }}
                border={{
                  borderColor: "#cbd5e1",
                  hoverBorderColor: "#1e3a8a",
                  borderWidth: 2,
                }}
                padding="16px 32px"
                rounded={100}
                hoverScale={103}
                className="w-full sm:w-auto shadow-md"
              />
            </div>

            <!-- Redes sociales -->
            <div
              class="flex items-center gap-4 justify-center lg:justify-start"
              data-animate="up"
              data-delay="400"
            >
              <a
                href="https://wa.me/5213318391094"
                target="_blank"
                rel="noopener noreferrer"
                class="w-11 h-11 rounded-full bg-green-100 hover:bg-green-500 flex items-center justify-center transition-colors group"
                aria-label="WhatsApp"
              >
                <svg
                  class="w-5 h-5 text-green-600 group-hover:text-white transition-colors"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.94 3.659 1.437 5.634 1.437h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                  ></path>
                </svg>
              </a>
              <a
                href="https://www.instagram.com/in_motus_/"
                target="_blank"
                rel="noopener noreferrer"
                class="w-11 h-11 rounded-full bg-pink-100 hover:bg-gradient-to-br hover:from-purple-500 hover:via-pink-500 hover:to-orange-400 flex items-center justify-center transition-all group"
                aria-label="Instagram"
              >
                <svg
                  class="w-5 h-5 text-pink-600 group-hover:text-white transition-colors"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.791-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                  ></path>
                </svg>
              </a>
            </div>
          </div>

          <!-- Hero Image/Visual -->
          <div class="relative" data-animate="right" data-delay="200">
            <div
              id="map-section"
              class="flex flex-col rounded-3xl bg-white/80 backdrop-blur-md border border-slate-200 p-4 sm:p-6 lg:p-8 shadow-2xl"
            >
              <!-- Opciones del Mapa -->
              <div class="flex items-center justify-between mb-3 shrink-0">
                <div class="flex bg-white rounded-lg shadow-sm border border-slate-200 text-sm overflow-hidden">
                  <button id="btn-map" class="px-4 py-1.5 bg-blue-50 text-blue-700 font-medium transition-colors">
                    Mapa
                  </button>
                  <button id="btn-sv" class="px-4 py-1.5 text-slate-600 hover:bg-slate-50 font-medium border-l border-slate-200 transition-colors">
                    Street View
                  </button>
                </div>

                <button id="btn-fullscreen" class="p-1.5 text-slate-500 hover:text-slate-800 bg-white hover:bg-slate-50 border border-slate-200 rounded-lg shadow-sm transition-colors" title="Pantalla completa" aria-label="Pantalla completa">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
                  </svg>
                </button>
              </div>

              <!-- Dynamic Map with Toggle -->
              <div
                id="map-wrapper"
                class="relative rounded-2xl overflow-hidden border border-slate-200 shadow-inner bg-slate-100 h-56 sm:h-72 lg:h-80 group bg-white"
              >
                <iframe
                  id="iframe-map"
                  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2673.976568728594!2d-103.382239!3d20.635229!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8428ad02770a943d%3A0x302eabe44ca182b2!2sINMOTUS!5e1!3m2!1ses-419!2smx!4v1772500807812!5m2!1ses-419!2smx"
                  width="100%"
                  height="100%"
                  style="border: 0;"
                  allowfullscreen="true"
                  loading="eager"
                  referrerpolicy="no-referrer-when-downgrade"
                  class="absolute inset-0 w-full h-full transition-opacity duration-300"></iframe>

                <iframe
                  id="iframe-sv"
                  src={`https://www.google.com/maps/embed/v1/streetview?key=${import.meta.env.GOOGLE_PLACES_API_KEY}&location=20.6350858,-103.3822707&heading=9.01&pitch=13.15`}
                  width="100%"
                  height="100%"
                  style="border: 0;"
                  allowfullscreen="true"
                  loading="lazy"
                  class="absolute inset-0 w-full h-full opacity-0 pointer-events-none transition-opacity duration-300"></iframe>
              </div>

              <script>
                const btnMap = document.getElementById('btn-map');
                const btnSv = document.getElementById('btn-sv');
                const btnFullscreen = document.getElementById('btn-fullscreen');
                const iframeMap = document.getElementById('iframe-map');
                const iframeSv = document.getElementById('iframe-sv');
                const mapWrapper = document.getElementById('map-wrapper');
                const mapSection = document.getElementById('map-section');

                if (btnMap && btnSv && iframeMap && iframeSv) {
                  btnMap.addEventListener('click', () => {
                    iframeMap.style.opacity = '1';
                    iframeMap.style.pointerEvents = 'auto';
                    iframeSv.style.opacity = '0';
                    iframeSv.style.pointerEvents = 'none';
                    
                    btnMap.className = 'px-4 py-1.5 bg-blue-50 text-blue-700 font-medium transition-colors';
                    btnSv.className = 'px-4 py-1.5 text-slate-600 hover:bg-slate-50 font-medium border-l border-slate-200 transition-colors';
                  });

                  btnSv.addEventListener('click', () => {
                    iframeSv.style.opacity = '1';
                    iframeSv.style.pointerEvents = 'auto';
                    iframeMap.style.opacity = '0';
                    iframeMap.style.pointerEvents = 'none';
                    
                    btnSv.className = 'px-4 py-1.5 bg-blue-50 text-blue-700 font-medium border-l border-slate-200 transition-colors';
                    btnMap.className = 'px-4 py-1.5 text-slate-600 hover:bg-slate-50 font-medium transition-colors';
                  });
                }

                if (btnFullscreen && mapSection && mapWrapper) {
                  let isFakeFullscreen = false;
                  
                  btnFullscreen.addEventListener('click', () => {
                    isFakeFullscreen = !isFakeFullscreen;
                    const animatedParent = mapSection.closest('[data-animate]');
                    
                    const parentSection = mapSection.closest('section');
                    
                    if (isFakeFullscreen) {
                      // Entrar a pantalla completa (Inline CSS para evitar problemas de Tailwind JIT)
                      if (animatedParent instanceof HTMLElement) {
                        animatedParent.style.transform = 'none';
                        animatedParent.style.transition = 'none';
                        animatedParent.style.zIndex = '99999';
                      }
                      
                      if (parentSection) {
                        parentSection.style.overflow = 'visible';
                        parentSection.style.zIndex = '99999';
                      }
                      
                      mapSection.style.position = 'fixed';
                      mapSection.style.top = '0';
                      mapSection.style.left = '0';
                      mapSection.style.width = '100vw';
                      mapSection.style.height = window.innerHeight + 'px'; // Fix iOS resize loop
                      mapSection.style.zIndex = '99999';
                      mapSection.style.borderRadius = '0';
                      mapSection.style.padding = '8px';
                      
                      const mapLocationInfo = document.getElementById('map-location-info');
                      if (mapLocationInfo) mapLocationInfo.style.display = 'none';
                      
                      mapWrapper.classList.remove('h-56', 'sm:h-72', 'lg:h-80');
                      mapWrapper.style.flex = '1 1 auto';
                      mapWrapper.style.height = '100%';
                      document.body.style.overflow = 'hidden';
                      
                      window.addEventListener('resize', updateMapHeight);
                      
                      // Cambiar icono a "contraer"
                      btnFullscreen.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 14h6m0 0v6m0-6l-7 7m17-11h-6m0 0V4m0 6l7-7M4 10h6m0 0V4m0 6l-7-7m17 11h-6m0 0v6m0-6l7 7"></path></svg>';
                    } else {
                      // Salir de pantalla completa
                      if (animatedParent instanceof HTMLElement) {
                        animatedParent.style.transform = '';
                        animatedParent.style.transition = '';
                        animatedParent.style.zIndex = '';
                      }
                      
                      if (parentSection) {
                        parentSection.style.overflow = '';
                        parentSection.style.zIndex = '';
                      }
                      
                      mapSection.style.position = '';
                      mapSection.style.top = '';
                      mapSection.style.left = '';
                      mapSection.style.width = '';
                      mapSection.style.height = '';
                      mapSection.style.zIndex = '';
                      mapSection.style.borderRadius = '';
                      mapSection.style.padding = '';
                      
                      const mapLocationInfo = document.getElementById('map-location-info');
                      if (mapLocationInfo) mapLocationInfo.style.display = '';
                      
                      mapWrapper.style.flex = '';
                      mapWrapper.style.height = '';
                      mapWrapper.classList.add('h-56', 'sm:h-72', 'lg:h-80');
                      document.body.style.overflow = '';
                      
                      window.removeEventListener('resize', updateMapHeight);
                      
                      // Restaurar icono de "expandir"
                      btnFullscreen.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path></svg>';
                    }
                  });
                  
                  function updateMapHeight() {
                    if (isFakeFullscreen && mapSection) {
                      mapSection.style.height = window.innerHeight + 'px';
                    }
                  }
                }
              </script>
              <div
                id="map-location-info"
                class="mt-3 p-3 sm:p-4 bg-blue-50 border border-blue-100 rounded-xl flex items-start gap-3 transition-all duration-300"
              >
                <svg
                  class="w-5 h-5 text-blue-900 shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <p class="text-sm text-slate-700 leading-snug">
                  <span class="font-semibold block text-blue-950 mb-0.5"
                    >Visítanos en:</span
                  >
                  C. Isla Tazmania 2040, Jardines de La Cruz, 44950 Guadalajara,
                  Jal.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Packages Section -->
    <Packages />

    <!-- Fisioterapeutas Section -->
    <Physiotherapists />

    <!-- Testimonios -->
    <Testimonials />

    <!-- FAQ -->
    <FAQ />

    <!-- Galería -->
    <Gallery />
  </main>
</Layout>
