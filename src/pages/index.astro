---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Packages from "../components/Packages.astro";
import Testimonials from "../components/Testimonials.astro";

const whatsappNumber = "523318391094";

const formatPhoneNumber = (num: string) => {
  const cleaned = num.replace(/\D/g, "");
  if (cleaned.length === 12) {
    return `+${cleaned.slice(0, 2)} ${cleaned.slice(2, 4)} ${cleaned.slice(4, 8)} ${cleaned.slice(8)}`;
  }
  return num;
};
---

<Layout>
  <Header />
  <main class="relative">
    <!-- Hero Section -->
    <section class="relative min-h-screen flex items-center overflow-hidden">
      <!-- Decorative background elements -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div
          class="absolute top-20 -left-40 w-96 h-96 bg-cyan-500/20 rounded-full blur-3xl"
        >
        </div>
        <div
          class="absolute bottom-20 -right-40 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl"
        >
        </div>
      </div>

      <div
        class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32"
      >
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <!-- Content -->
          <div class="text-center lg:text-left space-y-8">
            <h1
              class="text-5xl sm:text-6xl lg:text-7xl font-bold leading-tight text-slate-900"
            >
              Recupera tu <br class="hidden sm:block" />
              <span
                class="bg-gradient-to-r from-blue-950 via-blue-900 to-slate-800 bg-clip-text text-transparent"
              >
                Movimiento
              </span>
            </h1>
            <p
              class="text-xl sm:text-2xl text-slate-600 max-w-2xl mx-auto lg:mx-0"
            >
              Fisioterapia especializada y personalizada para ayudarte a volver
              a lo que más amas.
            </p>
            <div
              class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start"
            >
              <a
                href={`${import.meta.env.BASE_URL}citas`}
                class="group px-8 py-4 rounded-full bg-gradient-to-r from-blue-950 to-blue-900 hover:from-blue-900 hover:to-slate-800 text-white font-semibold transition-all shadow-lg shadow-blue-900/25 hover:shadow-blue-900/40 hover:scale-105"
              >
                Agendar Cita
                <svg
                  class="inline-block ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
              </a>
              <a
                href="#servicios"
                class="px-8 py-4 rounded-full border-2 border-slate-300 hover:border-blue-900 backdrop-blur-sm bg-white/50 hover:bg-slate-50 text-slate-900 font-semibold transition-all shadow-md"
              >
                Ver Servicios
              </a>
            </div>
          </div>

          <!-- Hero Image/Visual -->
          <div class="relative">
            <div
              class="aspect-square rounded-3xl bg-white/80 backdrop-blur-md border border-slate-200 p-8 shadow-2xl"
            >
              <!-- Decorative grid -->
              <div
                class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-60 mix-blend-overlay"
              >
              </div>

              <!-- Dynamic Map -->
              <div class="relative h-full flex flex-col">
                <div
                  class="flex-grow rounded-2xl overflow-hidden border border-slate-200 shadow-inner bg-slate-100 min-h-[300px]"
                >
                  <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2673.976568728594!2d-103.382239!3d20.635229!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8428ad02770a943d%3A0x302eabe44ca182b2!2sINMOTUS!5e1!3m2!1ses-419!2smx!4v1772500807812!5m2!1ses-419!2smx"
                    width="100%"
                    height="100%"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    class="w-full h-full"
                  />
                </div>

                <div class="mt-4 p-4 bg-blue-50 border border-blue-100 rounded-xl flex items-start gap-3">
                  <svg
                    class="w-5 h-5 text-blue-900 shrink-0 mt-0.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                  </svg>
                  <p class="text-sm text-slate-700 leading-snug">
                    <span class="font-semibold block text-blue-950 mb-0.5">Visítanos en:</span>
                    C. Isla Tazmania 2036-Interior A, Jardines de La Cruz, 44950 Guadalajara, Jal.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Packages Section -->
    <Packages />

    <!-- Testimonios -->
    <Testimonials />

  </main>
</Layout>
