---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Packages from "../components/Packages.astro";
import Physiotherapists from "../components/Physiotherapists.astro";
import Testimonials from "../components/Testimonials.astro";
import Gallery from "../components/Gallery.astro";
import Typewriter from "../components/Typewriter";

const whatsappNumber = "5213318391094";

const formatPhoneNumber = (num: string) => {
  const cleaned = num.replace(/\D/g, "");
  if (cleaned.length === 12) {
    return `+${cleaned.slice(0, 2)} ${cleaned.slice(2, 4)} ${cleaned.slice(4, 8)} ${cleaned.slice(8)}`;
  }
  return num;
};
---

<Layout
  title="InMotus | Fisioterapia Especializada en Guadalajara | Rehabilitación Física"
  description="Recupera tu movimiento con los mejores fisioterapeutas en Guadalajara. Especialistas en rehabilitación física, deportiva y geriátrica en Jardines de la Cruz."
>
  <Header />
  <main class="relative">
    <!-- Hero Section -->
    <section
      class="relative flex items-center overflow-hidden pt-6 pb-6 sm:pt-10 sm:pb-10 lg:pt-14 lg:pb-12"
    >
      <!-- Decorative background elements -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div
          class="absolute top-20 -left-40 w-96 h-96 bg-cyan-500/20 rounded-full blur-3xl animate-float"
        >
        </div>
        <div
          class="absolute bottom-20 -right-40 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl animate-float-slow"
        >
        </div>
        <div
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl animate-pulse-soft"
        >
        </div>
      </div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-0 lg:py-0">
        <div class="grid lg:grid-cols-2 gap-6 lg:gap-10 items-center">
          <!-- Content -->
          <div
            class="text-center lg:text-left space-y-5 sm:space-y-8"
            data-animate="left"
          >
            <h1
              class="text-4xl sm:text-6xl lg:text-7xl font-bold leading-tight text-slate-900 min-h-[2.5em]"
            >
              <Typewriter
                client:load
                className="bg-gradient-to-r from-blue-950 via-blue-900 to-slate-800 bg-clip-text text-transparent"
              /><span
                class="typewriter-cursor bg-gradient-to-b from-blue-950 to-blue-800"
              ></span>
            </h1>
            <p
              class="text-xl sm:text-2xl text-slate-600 max-w-2xl mx-auto lg:mx-0"
              data-animate="up"
              data-delay="150"
            >
              Fisioterapia especializada y personalizada para ayudarte a volver
              a lo que más amas.
            </p>
            <div
              class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start"
              data-animate="up"
              data-delay="280"
            >
              <a
                href={`${import.meta.env.BASE_URL}citas`}
                class="group px-8 py-4 rounded-full bg-gradient-to-r from-blue-950 to-blue-900 hover:from-blue-900 hover:to-slate-800 text-white font-semibold transition-all shadow-lg shadow-blue-900/25 hover:shadow-blue-900/40 hover:scale-105"
              >
                Agendar Cita
                <svg
                  class="inline-block ml-2 w-5 h-5 group-hover:scale-110 transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                  ></path>
                </svg>
              </a>
              <a
                href="#servicios"
                class="px-8 py-4 rounded-full border-2 border-slate-300 hover:border-blue-900 backdrop-blur-sm bg-white/50 hover:bg-slate-50 text-slate-900 font-semibold transition-all shadow-md"
              >
                Ver Servicios
              </a>
            </div>

            <!-- Redes sociales -->
            <div
              class="flex items-center gap-4 justify-center lg:justify-start"
              data-animate="up"
              data-delay="400"
            >
              <a
                href="https://wa.me/5213318391094"
                target="_blank"
                rel="noopener noreferrer"
                class="w-11 h-11 rounded-full bg-green-100 hover:bg-green-500 flex items-center justify-center transition-colors group"
                aria-label="WhatsApp"
              >
                <svg
                  class="w-5 h-5 text-green-600 group-hover:text-white transition-colors"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.94 3.659 1.437 5.634 1.437h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                  ></path>
                </svg>
              </a>
              <a
                href="https://www.instagram.com/in_motus_/"
                target="_blank"
                rel="noopener noreferrer"
                class="w-11 h-11 rounded-full bg-pink-100 hover:bg-gradient-to-br hover:from-purple-500 hover:via-pink-500 hover:to-orange-400 flex items-center justify-center transition-all group"
                aria-label="Instagram"
              >
                <svg
                  class="w-5 h-5 text-pink-600 group-hover:text-white transition-colors"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.791-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                  ></path>
                </svg>
              </a>
            </div>
          </div>

          <!-- Hero Image/Visual -->
          <div class="relative" data-animate="right" data-delay="200">
            <div
              class="rounded-3xl bg-white/80 backdrop-blur-md border border-slate-200 p-4 sm:p-6 lg:p-8 shadow-2xl"
            >
              <!-- Dynamic Map -->
              <div
                class="rounded-2xl overflow-hidden border border-slate-200 shadow-inner bg-slate-100 h-56 sm:h-72 lg:h-80"
              >
                <iframe
                  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2673.976568728594!2d-103.382239!3d20.635229!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8428ad02770a943d%3A0x302eabe44ca182b2!2sINMOTUS!5e1!3m2!1ses-419!2smx!4v1772500807812!5m2!1ses-419!2smx"
                  width="100%"
                  height="100%"
                  style="border: 0;"
                  allowfullscreen="true"
                  loading="eager"
                  referrerpolicy="no-referrer-when-downgrade"
                  class="w-full h-full"></iframe>
              </div>
              <div
                class="mt-3 p-3 sm:p-4 bg-blue-50 border border-blue-100 rounded-xl flex items-start gap-3"
              >
                <svg
                  class="w-5 h-5 text-blue-900 shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <p class="text-sm text-slate-700 leading-snug">
                  <span class="font-semibold block text-blue-950 mb-0.5"
                    >Visítanos en:</span
                  >
                  C. Isla Tazmania 2036-Interior A, Jardines de La Cruz, 44950 Guadalajara,
                  Jal.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Packages Section -->
    <Packages />

    <!-- Fisioterapeutas Section -->
    <Physiotherapists />

    <!-- Testimonios -->
    <Testimonials />

    <!-- Galería -->
    <Gallery />
  </main>
</Layout>
