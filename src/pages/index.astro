---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Packages from "../components/Packages.astro";
import fetchApi from "../lib/strapi";

interface ClinicInfo {
  address: string;
  mapEmbedUrl: string;
  facebook?: string;
  instagram?: string;
  whatsapp?: string;
}

let clinicInfo: ClinicInfo | null = null;

try {
  clinicInfo = await fetchApi<ClinicInfo>({
    endpoint: "clinic-info",
    wrappedByKey: "data",
  });
} catch (e) {
  console.error("Error fetching clinic info:", e);
}

const formatPhoneNumber = (num?: string) => {
  if (!num) return "+52 33 1839 1094";
  // Si el número viene como 523318391094 -> +52 33 1839 1094
  const cleaned = num.replace(/\D/g, "");
  if (cleaned.length === 12) {
    return `+${cleaned.slice(0, 2)} ${cleaned.slice(2, 4)} ${cleaned.slice(4, 8)} ${cleaned.slice(8)}`;
  }
  return num;
};
---

<Layout>
  <Header />
  <main class="relative">
    <!-- Hero Section -->
    <section class="relative min-h-screen flex items-center overflow-hidden">
      <!-- Decorative background elements -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div
          class="absolute top-20 -left-40 w-96 h-96 bg-cyan-500/20 rounded-full blur-3xl"
        >
        </div>
        <div
          class="absolute bottom-20 -right-40 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl"
        >
        </div>
      </div>

      <div
        class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32"
      >
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <!-- Content -->
          <div class="text-center lg:text-left space-y-8">
            <h1
              class="text-5xl sm:text-6xl lg:text-7xl font-bold leading-tight text-slate-900"
            >
              Recupera tu <br class="hidden sm:block" />
              <span
                class="bg-gradient-to-r from-blue-950 via-blue-900 to-slate-800 bg-clip-text text-transparent"
              >
                Movimiento
              </span>
            </h1>
            <p
              class="text-xl sm:text-2xl text-slate-600 max-w-2xl mx-auto lg:mx-0"
            >
              Fisioterapia especializada y personalizada para ayudarte a volver
              a lo que más amas.
            </p>
            <div
              class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start"
            >
              <a
                href="/citas"
                class="group px-8 py-4 rounded-full bg-gradient-to-r from-blue-950 to-blue-900 hover:from-blue-900 hover:to-slate-800 text-white font-semibold transition-all shadow-lg shadow-blue-900/25 hover:shadow-blue-900/40 hover:scale-105"
              >
                Agendar Cita
                <svg
                  class="inline-block ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
              </a>
              <a
                href="#servicios"
                class="px-8 py-4 rounded-full border-2 border-slate-300 hover:border-blue-900 backdrop-blur-sm bg-white/50 hover:bg-slate-50 text-slate-900 font-semibold transition-all shadow-md"
              >
                Ver Servicios
              </a>
            </div>
          </div>

          <!-- Hero Image/Visual -->
          <div class="relative">
            <div
              class="aspect-square rounded-3xl bg-white/80 backdrop-blur-md border border-slate-200 p-8 shadow-2xl"
            >
              <!-- Decorative grid -->
              <div
                class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-60 mix-blend-overlay"
              >
              </div>

              <!-- Dynamic Map -->
              <div class="relative h-full flex flex-col">
                <div
                  class="flex-grow rounded-2xl overflow-hidden border border-slate-200 shadow-inner bg-slate-100 min-h-[300px]"
                >
                  {
                    clinicInfo?.mapEmbedUrl ? (
                      <iframe
                        src={clinicInfo.mapEmbedUrl}
                        width="100%"
                        height="100%"
                        style="border:0;"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        class="w-full h-full"
                      />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center text-slate-400 p-8 text-center">
                        <div>
                          <svg
                            class="w-12 h-12 mx-auto mb-3 opacity-20"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M9 20l-5.447-2.724A2 2 0 013 15.488V5.512a2 2 0 011.553-1.954L9 1l6 3 5.447-2.724A2 2 0 0121 3.112v9.976a2 2 0 01-1.553 1.954L15 23l-6-3z"
                            />
                          </svg>
                          <p>
                            Configura el mapa en Strapi para mostrar tu
                            ubicación
                          </p>
                        </div>
                      </div>
                    )
                  }
                </div>

                {
                  clinicInfo?.address && (
                    <div class="mt-4 p-4 bg-blue-50 border border-blue-100 rounded-xl flex items-start gap-3">
                      <svg
                        class="w-5 h-5 text-blue-900 shrink-0 mt-0.5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                        />
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                        />
                      </svg>
                      <p class="text-sm text-slate-700 leading-snug">
                        <span class="font-semibold block text-blue-950 mb-0.5">
                          Visítanos en:
                        </span>
                        {clinicInfo.address}
                      </p>
                    </div>
                  )
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Packages Section -->
    <Packages />

    <!-- Footer -->
    <footer
      class="relative mt-32 border-t border-slate-200 bg-white/80 backdrop-blur-sm"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid md:grid-cols-3 gap-8 text-center md:text-left">
          <div>
            <div
              class="flex items-center gap-2 justify-center md:justify-start mb-4"
            >
              <img src="/logo.png" alt="INMOTUS Logo" class="h-14 w-auto" />
            </div>
            <p class="text-slate-600">
              Recuperando movimiento, restaurando vidas.
            </p>
          </div>
          <div>
            <h3 class="font-semibold mb-4 text-slate-900">Enlaces</h3>
            <ul class="space-y-2 text-slate-600">
              <li>
                <a
                  href="#servicios"
                  class="hover:text-blue-900 transition-colors">Servicios</a
                >
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold mb-4 text-slate-900">Contacto</h3>
            <ul class="space-y-3 text-slate-600">
              <li>inmotusfisio@gmail.com</li>
              <li class="flex items-center justify-center md:justify-start">
                <a
                  href={`https://wa.me/${clinicInfo?.whatsapp || "523318391094"}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 hover:text-blue-900 transition-colors group"
                >
                  <svg
                    class="w-5 h-5 text-green-600 group-hover:scale-110 transition-transform"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.94 3.659 1.437 5.634 1.437h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                    ></path>
                  </svg>
                  {formatPhoneNumber(clinicInfo?.whatsapp)}
                </a>
              </li>
              <li class="flex flex-col gap-3">
                {
                  clinicInfo?.facebook && (
                    <a
                      href={clinicInfo.facebook}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center gap-2 hover:text-blue-900 transition-colors group justify-center md:justify-start"
                    >
                      <svg
                        class="w-5 h-5 text-blue-600 group-hover:scale-110 transition-transform"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                      </svg>
                      <span class="text-sm">Facebook</span>
                    </a>
                  )
                }
                {
                  clinicInfo?.instagram && (
                    <a
                      href={clinicInfo.instagram}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center gap-2 hover:text-pink-600 transition-colors group justify-center md:justify-start"
                    >
                      <svg
                        class="w-5 h-5 text-pink-600 group-hover:scale-110 transition-transform"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.791-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                      </svg>
                      <span class="text-sm font-medium">in_motus_</span>
                    </a>
                  )
                }
              </li>
            </ul>
          </div>
        </div>
        <div
          class="mt-8 pt-8 border-t border-slate-200 text-center text-slate-500"
        >
          <p>&copy; 2026 INMOTUS. Todos los derechos reservados.</p>
        </div>
      </div>
    </footer>
  </main>
</Layout>
