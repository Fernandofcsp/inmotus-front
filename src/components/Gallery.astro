---
import fs from "node:fs";
import path from "node:path";
import https from "node:https";
import CoverflowCarousel from "./CoverflowCarousel";

const apiKey = import.meta.env.GOOGLE_PLACES_API_KEY;
const placeId = import.meta.env.GOOGLE_PLACE_ID;
const galleryDir = path.join(process.cwd(), "public", "gallery");

// Ensure directory exists and clear it to ensure fresh content
if (!fs.existsSync(galleryDir)) {
    try {
        fs.mkdirSync(galleryDir, { recursive: true });
    } catch (e) {
        console.error("Could not create gallery directory", e);
    }
} else {
    try {
        const files = fs.readdirSync(galleryDir);
        for (const file of files) {
            fs.unlinkSync(path.join(galleryDir, file));
        }
    } catch (e) {
        console.error("Could not clear gallery directory", e);
    }
}

let photoPaths: string[] = [];

if (apiKey && placeId) {
    try {
        const detailsUrl = `https://maps.googleapis.com/maps/api/place/details/json?place_id=${placeId}&fields=photos&key=${apiKey}`;
        const res = await fetch(detailsUrl);
        const data = await res.json();

        if (data.result?.photos) {
            const seenRefs = new Set();
            const seenDims = new Set();
            const uniquePhotos = data.result.photos.filter((p: any) => {
                const dim = `${p.height}x${p.width}`;
                if (seenRefs.has(p.photo_reference) || seenDims.has(dim))
                    return false;
                seenRefs.add(p.photo_reference);
                seenDims.add(dim);
                return true;
            });

            const photos = uniquePhotos.slice(0, 10);

            for (let i = 0; i < photos.length; i++) {
                const ref = photos[i].photo_reference;
                const fileName = `gp-${i}.jpg`;
                const localPath = path.join(galleryDir, fileName);
                const publicPath = `${import.meta.env.BASE_URL}gallery/${fileName}`;

                const photoUrl = `https://maps.googleapis.com/maps/api/place/photo?maxwidth=1200&photoreference=${ref}&key=${apiKey}`;

                await new Promise((resolve, reject) => {
                    const file = fs.createWriteStream(localPath);
                    https
                        .get(photoUrl, (response) => {
                            if (response.statusCode === 302 && response.headers.location) {
                                https
                                    .get(response.headers.location, (res2) => {
                                        res2.pipe(file);
                                        file.on("finish", () => { file.close(); resolve(true); });
                                    })
                                    .on("error", reject);
                            } else {
                                response.pipe(file);
                                file.on("finish", () => { file.close(); resolve(true); });
                            }
                        })
                        .on("error", (err) => {
                            fs.unlink(localPath, () => {});
                            reject(err);
                        });
                });
                photoPaths.push(publicPath);
            }
        }
    } catch (e) {
        console.error("Gallery: Error fetching Google photos", e);
    }
}

// Convert string[] → { src: string }[] for CoverflowCarousel
const carouselSlides = photoPaths.map((src, i) => ({ src, alt: `Instalación InMotus ${i + 1}` }));
---

{
    carouselSlides.length > 0 && (
        <section class="py-16 sm:py-24 bg-white overflow-hidden">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-4" data-animate="up">
                    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mb-4">
                        Nuestras{" "}
                        <span class="bg-gradient-to-r from-blue-900 to-blue-600 bg-clip-text text-transparent">
                            Instalaciones
                        </span>
                    </h2>
                    <p class="text-lg text-slate-600 max-w-2xl mx-auto">
                        Explora nuestro centro de rehabilitación y conoce el
                        entorno donde trabajamos para tu bienestar.
                    </p>
                </div>

                <CoverflowCarousel
                    client:load
                    slides={carouselSlides}
                    cardWidth="clamp(200px, 28vw, 340px)"
                    rotate={44}
                    depth={0.6}
                    lens={3}
                    falloff={0.56}
                    fade={0.1}
                    gap={0.05}
                    radius={20}
                    loop={true}
                    showNavigation={true}
                    showPagination={true}
                />

                <div class="mt-4 text-center">
                    <a
                        href="https://www.google.com/maps/place/InMotus/@20.635229,-103.382239,17z/data=!4m7!3m6!1s0x8428ad02770a943d:0x302eabe44ca182b2!8m2!3d20.635229!4d-103.382239!10e5!16s%2Fg%2F11z0vcbhyw?hl=es-MX&entry=ttu"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold transition-all hover:scale-105"
                    >
                        Ver más fotos en Google Maps
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                    </a>
                </div>
            </div>
        </section>
    )
}
