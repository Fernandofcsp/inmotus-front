---
const whatsappNumber = "523318391094";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=Hola,%20tengo%20una%20duda%20sobre%20fisioterapia`;
---

<header
    class="sticky top-0 z-50 backdrop-blur-lg bg-white/90 border-b border-slate-200/50 transition-all duration-300"
>
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-4">
        <div class="flex items-center justify-between h-16">
            <div class="flex items-center gap-2">
                <a href={import.meta.env.BASE_URL} class="flex items-center gap-2 group">
                    <div class="transition-colors">
                        <img
                            src={`${import.meta.env.BASE_URL}logo.png`}
                            alt="INMOTUS Logo"
                            class="h-16 md:h-16 mt-4 w-auto group-hover:scale-105 transition-transform"
                        />
                    </div>
                </a>
            </div>

            <div class="hidden md:flex items-center gap-6 mt-4">
                <a
                    href={`${import.meta.env.BASE_URL}#servicios`}
                    class="text-slate-700 hover:text-blue-900 transition-colors font-medium"
                    >Servicios</a
                >
                <a
                    href={`https://wa.me/${whatsappNumber}?text=Hola,%20tengo%20una%20duda%20sobre%20fisioterapia`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-slate-700 hover:text-blue-900 transition-colors font-medium"
                    >Contacto</a
                >
                <div class="h-6 w-px bg-slate-200 mx-1"></div>
                <a
                    href={`${import.meta.env.BASE_URL}citas`}
                    class="px-5 py-2.5 rounded-full bg-blue-900 hover:bg-slate-900 text-white font-semibold transition-all shadow-md shadow-blue-900/20"
                >
                    Agendar
                </a>
            </div>

            <!-- Botón hamburguesa -->
            <!-- <button
                id="mobile-menu-btn"
                aria-label="Abrir menú"
                aria-expanded="false"
                class="md:hidden p-2 rounded-lg text-slate-900 hover:bg-slate-100 transition-colors mt-4"
            >
                <svg id="icon-open" class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
                <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button> -->
        </div>

        <!-- Menú móvil desplegable -->
        <div id="mobile-menu" class="hidden md:hidden pb-4 border-t border-slate-200/50 mt-1">
            <div class="flex flex-col gap-1 pt-3">
                <a
                    href={`${import.meta.env.BASE_URL}#servicios`}
                    class="px-3 py-2.5 rounded-lg text-slate-700 hover:bg-slate-100 hover:text-blue-900 font-medium transition-colors"
                >Servicios</a>
                <a
                    href={`https://wa.me/${whatsappNumber}?text=Hola,%20tengo%20una%20duda%20sobre%20fisioterapia`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-3 py-2.5 rounded-lg text-slate-700 hover:bg-slate-100 hover:text-blue-900 font-medium transition-colors"
                >Contacto</a>
                <a
                    href={`${import.meta.env.BASE_URL}citas`}
                    class="mt-1 px-5 py-3 rounded-xl bg-blue-900 hover:bg-slate-900 text-white font-semibold text-center transition-all"
                >Agendar Cita</a>
            </div>
        </div>
    </nav>
</header>

<script>
    const btn = document.getElementById('mobile-menu-btn')!;
    const menu = document.getElementById('mobile-menu')!;
    const iconOpen = document.getElementById('icon-open')!;
    const iconClose = document.getElementById('icon-close')!;

    btn.addEventListener('click', () => {
        const isOpen = !menu.classList.contains('hidden');
        menu.classList.toggle('hidden', isOpen);
        iconOpen.classList.toggle('hidden', !isOpen);
        iconClose.classList.toggle('hidden', isOpen);
        btn.setAttribute('aria-expanded', String(!isOpen));
    });

    // Cerrar al hacer clic en un enlace
    menu.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
            menu.classList.add('hidden');
            iconOpen.classList.remove('hidden');
            iconClose.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
        });
    });
</script>
