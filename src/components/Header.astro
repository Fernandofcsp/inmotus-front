---
import fetchApi from "../lib/strapi";

interface ClinicInfo {
    address: string;
    mapEmbedUrl: string;
    facebook?: string;
    instagram?: string;
    whatsapp?: string;
}

let clinicInfo: ClinicInfo | null = null;

try {
    clinicInfo = await fetchApi<ClinicInfo>({
        endpoint: "clinic-info",
        wrappedByKey: "data",
    });
} catch (e) {
    console.error("Error fetching clinic info in Header:", e);
}

const whatsappNumber = clinicInfo?.whatsapp || "523318391094";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=Hola,%20tengo%20una%20duda%20sobre%20fisioterapia`;
---

<header
    class="sticky top-0 z-50 backdrop-blur-lg bg-white/90 border-b border-slate-200/50 transition-all duration-300"
>
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            <div class="flex items-center gap-2">
                <a href={import.meta.env.BASE_URL} class="flex items-center gap-2 group">
                    <div class="transition-colors">
                        <img
                            src={`${import.meta.env.BASE_URL}logo.png`}
                            alt="INMOTUS Logo"
                            class="h-10 md:h-12 w-auto group-hover:scale-105 transition-transform"
                        />
                    </div>
                </a>
            </div>

            <div class="hidden md:flex items-center gap-6">
                <a
                    href={`${import.meta.env.BASE_URL}#servicios`}
                    class="text-slate-700 hover:text-blue-900 transition-colors font-medium"
                    >Servicios</a
                >
                <a
                    href=`https://wa.me/${whatsappNumber}?text=Hola,%20tengo%20una%20duda%20sobre%20fisioterapia`
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-slate-700 hover:text-blue-900 transition-colors font-medium"
                    >Contacto</a
                >

                <div class="h-6 w-px bg-slate-200 mx-1"></div>

                <a
                    href={`${import.meta.env.BASE_URL}citas`}
                    class="px-5 py-2.5 rounded-full bg-blue-900 hover:bg-slate-900 text-white font-semibold transition-all shadow-md shadow-blue-900/20"
                >
                    Agendar
                </a>
            </div>

            <button
                class="md:hidden p-2 rounded-lg text-slate-900 dark:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
            >
                <svg
                    class="w-6 h-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>
        </div>
    </nav>
</header>
