---
const whatsappNumber = "5213318391094";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=Hola,%20tengo%20una%20duda%20sobre%20fisioterapia`;
---

<header
    class="sticky top-0 z-50 bg-white border-b border-slate-200/50 transition-all duration-300 animate-slide-down"
>
    <nav
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between"
    >
        <!-- Logo -->
        <a
            href={import.meta.env.BASE_URL}
            class="flex items-center gap-2 group shrink-0"
        >
            <img
                src={`${import.meta.env.BASE_URL}logo.png`}
                alt="Logo de InMotus Fisioterapia en Guadalajara"
                class="h-14 sm:h-16 w-auto group-hover:scale-105 transition-transform duration-300"
            />
        </a>

        <!-- Desktop nav -->
        <div class="hidden md:flex items-center gap-6">
            <a
                href={`${import.meta.env.BASE_URL}#servicios`}
                class="text-slate-700 hover:text-blue-900 transition-colors duration-200 font-medium"
                >Servicios</a
            >
            <a
                href={`${import.meta.env.BASE_URL}#paquetes`}
                class="text-slate-700 hover:text-blue-900 transition-colors duration-200 font-medium"
                >Paquetes</a
            >
            <a
                href={`${import.meta.env.BASE_URL}#fisioterapeutas`}
                class="text-slate-700 hover:text-blue-900 transition-colors duration-200 font-medium"
                >Fisioterapeutas</a
            >
            <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-slate-700 hover:text-blue-900 transition-colors duration-200 font-medium"
                >Contacto</a
            >
            <div class="h-6 w-px bg-slate-200 mx-1"></div>
            <a
                href={`${import.meta.env.BASE_URL}citas`}
                class="px-5 py-2.5 rounded-full bg-blue-900 hover:bg-slate-900 text-white font-semibold transition-all duration-200 shadow-md shadow-blue-900/20 hover:scale-105 hover:shadow-blue-900/30"
            >
                Agendar
            </a>
        </div>

        <!-- Hamburger button -->
        <button
            id="mobile-menu-btn"
            aria-label="Abrir menú"
            aria-expanded="false"
            class="md:hidden p-2 rounded-lg text-slate-900 hover:bg-slate-100 transition-colors"
        >
            <svg
                id="icon-open"
                class="w-7 h-7"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg
                id="icon-close"
                class="w-7 h-7 hidden"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </nav>
    <!-- Mobile menu overlay -->
    <div
        id="mobile-menu"
        class="hidden absolute inset-x-0 top-full bg-white z-40 md:hidden border-b border-slate-200 shadow-xl animate-slide-down"
    >
        <div class="flex flex-col gap-1 p-4">
            <a
                href={`${import.meta.env.BASE_URL}#servicios`}
                class="px-4 py-3 rounded-lg text-slate-700 hover:bg-slate-50 hover:text-blue-900 font-semibold transition-all"
                >Servicios</a
            >
            <a
                href={`${import.meta.env.BASE_URL}#paquetes`}
                class="px-4 py-3 rounded-lg text-slate-700 hover:bg-slate-50 hover:text-blue-900 font-semibold transition-all"
                >Paquetes</a
            >
            <a
                href={`${import.meta.env.BASE_URL}#faq`}
                class="px-4 py-3 rounded-lg text-slate-700 hover:bg-slate-50 hover:text-blue-900 font-semibold transition-all"
                >Preguntas</a
            >
            <a
                href={`${import.meta.env.BASE_URL}#fisioterapeutas`}
                class="px-4 py-3 rounded-lg text-slate-700 hover:bg-slate-50 hover:text-blue-900 font-semibold transition-all"
                >Fisioterapeutas</a
            >
            <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-3 rounded-lg text-slate-700 hover:bg-slate-50 hover:text-blue-900 font-semibold transition-all"
                >Contacto</a
            >
            <div class="pt-2 px-4 pb-4">
                <a
                    href={`${import.meta.env.BASE_URL}citas`}
                    class="flex items-center justify-center gap-2 w-full px-6 py-3.5 rounded-xl bg-blue-900 hover:bg-slate-900 text-white font-bold text-lg shadow-lg shadow-blue-900/20 transition-all active:scale-95"
                >
                    Agendar Cita
                </a>
            </div>
        </div>
    </div>
</header>

<script>
    const btn = document.getElementById("mobile-menu-btn")!;
    const menu = document.getElementById("mobile-menu")!;
    const iconOpen = document.getElementById("icon-open")!;
    const iconClose = document.getElementById("icon-close")!;

    btn.addEventListener("click", () => {
        const isOpen = !menu.classList.contains("hidden");
        menu.classList.toggle("hidden", isOpen);
        iconOpen.classList.toggle("hidden", !isOpen);
        iconClose.classList.toggle("hidden", isOpen);
        btn.setAttribute("aria-expanded", String(!isOpen));
    });

    menu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
            menu.classList.add("hidden");
            iconOpen.classList.remove("hidden");
            iconClose.classList.add("hidden");
            btn.setAttribute("aria-expanded", "false");
        });
    });
</script>
