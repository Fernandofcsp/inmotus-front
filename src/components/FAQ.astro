---
import { fetchFAQs } from "../lib/sheets";

const faqs = await fetchFAQs();
---

{
    faqs.length > 0 && (
        <section id="faq" class="py-16 sm:py-24 bg-slate-50 overflow-hidden">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-16" data-animate="up">
                    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mb-4">
                        Preguntas{" "}
                        <span class="bg-gradient-to-r from-blue-900 to-blue-600 bg-clip-text text-transparent">
                            Frecuentes
                        </span>
                    </h2>
                    <p class="text-lg text-slate-600">
                        Resolvemos tus dudas sobre nuestros servicios de
                        fisioterapia en Guadalajara para que inicies tu
                        recuperación con confianza.
                    </p>
                </div>

                <div class="space-y-4">
                    {faqs.map((faq, i) => (
                        <div
                            class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden transition-all hover:shadow-md"
                            data-animate="up"
                            data-delay={String(i * 100)}
                        >
                            <details class="group">
                                <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                                    <h3 class="text-lg font-bold text-slate-900 pr-8">
                                        {faq.question}
                                    </h3>
                                    <div class="bg-blue-50 p-2 rounded-full text-blue-900 transition-transform group-open:rotate-180">
                                        <svg
                                            class="w-5 h-5"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M19 9l-7 7-7-7"
                                            />
                                        </svg>
                                    </div>
                                </summary>
                                <div class="px-6 pb-6 text-slate-600 leading-relaxed border-t border-slate-50 pt-4">
                                    <p>{faq.answer}</p>
                                </div>
                            </details>
                        </div>
                    ))}
                </div>

                <div
                    class="mt-12 p-8 rounded-3xl bg-blue-900 text-white text-center shadow-xl shadow-blue-900/20"
                    data-animate="up"
                >
                    <h3 class="text-xl font-bold mb-2">
                        ¿Tienes una duda específica?
                    </h3>
                    <p class="text-blue-100 mb-6 font-medium">
                        Nuestro equipo está listo para asesorarte personalmente
                        sin compromiso.
                    </p>
                    <a
                        href="https://wa.me/5213318391094"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-8 py-4 bg-white text-blue-900 rounded-xl font-bold hover:bg-slate-50 transition-all hover:scale-105"
                    >
                        Hablar con un Especialista
                        <svg
                            class="w-5 h-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                            />
                        </svg>
                    </a>
                </div>
            </div>
        </section>
    )
}

<style>
    /* Remove default summary arrow */
    summary::-webkit-details-marker {
        display: none;
    }
</style>
