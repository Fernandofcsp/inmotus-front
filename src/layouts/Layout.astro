---
// Layout base con Tailwind CSS
import "../styles/global.css";
import { fetchPhysiotherapists } from "../lib/sheets";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "InMotus | Fisioterapia Especializada",
  description = "Fisioterapia especializada y personalizada para ayudarte a volver a lo que más amas.",
} = Astro.props;

// Fetch physios for the schema
const physios = await fetchPhysiotherapists();

const structuredData = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "Physiotherapy"],
  name: "InMotus Fisioterapia Especializada",
  alternateName: "InMotus",
  description:
    description || "Clínica de fisioterapia especializada en Guadalajara.",
  url: "https://inmotus.mx/",
  logo: "https://inmotus.mx/logo.png",
  image: "https://inmotus.mx/logo.png",
  priceRange: "$$",
  telephone: "+523318391094",
  email: "inmotusfisio@gmail.com",
  address: {
    "@type": "PostalAddress",
    streetAddress: "C. Isla Tazmania 2036-Interior A, Jardines de La Cruz",
    addressLocality: "Guadalajara",
    addressRegion: "Jal.",
    postalCode: "44950",
    addressCountry: "MX",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 20.635229,
    longitude: -103.382239,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "09:00",
      closes: "20:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Saturday",
      opens: "09:00",
      closes: "14:00",
    },
  ],
  sameAs: [
    "https://www.instagram.com/in_motus_/",
    "https://www.google.com/maps/place/InMotus/@20.635229,-103.382239,17z",
  ],
  employee: physios.map((p) => ({
    "@type": "Physician",
    name: p.name,
    url: `https://inmotus.mx/#fisioterapeutas`,
    medicalCode: {
      "@type": "MedicalCode",
      codeValue: p.cedula || "N/A",
      codingSystem: "SEP-CédulaProfesional",
    },
    honorificSuffix: "Lic. en Fisioterapia",
    description: p.experience
      ? p.experience.replace(/\|/g, ", ")
      : "Especialista en Fisioterapia",
  })),
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      type="image/png"
      href={`${import.meta.env.BASE_URL}favicon.png`}
    />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://inmotus.mx/" />

    <!-- Schema.org JSON-LD para SEO 2026 -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://inmotus.mx/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://inmotus.mx/logo.png" />
    <meta property="og:site_name" content="InMotus Fisioterapia" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://inmotus.mx/" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://inmotus.mx/logo.png" />
