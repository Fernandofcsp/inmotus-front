---
// Layout base con Tailwind CSS
import "../styles/global.css";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>InMotus</title>
    <meta
      name="description"
      content="Fisioterapia especializada y personalizada para ayudarte a volver a lo que más amas."
    />
    <script is:inline>
      // Modo oscuro desactivado a petición del usuario
      document.documentElement.classList.remove("dark");
    </script>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 font-sans antialiased">
    <slot />

    <!-- Footer global -->
    <footer class="relative mt-8 sm:mt-12 border-t border-slate-200 bg-white/80 backdrop-blur-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
        <div class="grid md:grid-cols-3 gap-10 text-center md:text-left">

          <!-- Columna 1: Logo + tagline -->
          <div class="flex flex-col items-center md:items-start gap-4">
            <img src={`${import.meta.env.BASE_URL}logo.png`} alt="INMOTUS Logo" class="h-14 w-auto" />
            <p class="text-slate-500 text-sm leading-relaxed">
              Fisioterapia especializada y personalizada.<br/>Recuperando movimiento, restaurando vidas.
            </p>
          </div>

          <!-- Columna 2: Redes Sociales -->
          <div class="flex flex-col items-center md:items-start">
            <h3 class="font-semibold mb-5 text-slate-900">Redes Sociales</h3>
            <div class="flex flex-col gap-4">
              <a
                href="https://wa.me/523318391094"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 group"
              >
                <span class="w-9 h-9 rounded-full bg-green-100 flex items-center justify-center flex-shrink-0 group-hover:bg-green-500 transition-colors">
                  <svg class="w-5 h-5 text-green-600 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.94 3.659 1.437 5.634 1.437h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                </span>
                <div class="text-left">
                  <p class="text-xs text-slate-400 font-medium">WhatsApp</p>
                  <p class="text-sm text-slate-700 group-hover:text-green-600 transition-colors font-medium">+52 33 1839 1094</p>
                </div>
              </a>
              <a
                href="https://www.instagram.com/in_motus_/"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 group"
              >
                <span class="w-9 h-9 rounded-full bg-pink-100 flex items-center justify-center flex-shrink-0 group-hover:bg-gradient-to-br group-hover:from-purple-500 group-hover:via-pink-500 group-hover:to-orange-400 transition-all">
                  <svg class="w-5 h-5 text-pink-600 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.791-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                </span>
                <div class="text-left">
                  <p class="text-xs text-slate-400 font-medium">Instagram</p>
                  <p class="text-sm text-slate-700 group-hover:text-pink-600 transition-colors font-medium">@in_motus_</p>
                </div>
              </a>
            </div>
          </div>

          <!-- Columna 3: Contacto -->
          <div class="flex flex-col items-center md:items-start">
            <h3 class="font-semibold mb-5 text-slate-900">Contacto</h3>
            <ul class="space-y-4 text-slate-600">
              <li>
                <a href="mailto:inmotusfisio@gmail.com" class="flex items-center gap-3 hover:text-blue-900 transition-colors group">
                  <svg class="w-5 h-5 text-blue-600 flex-shrink-0 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                  <span class="text-sm">inmotusfisio@gmail.com</span>
                </a>
              </li>
              <li>
                <a
                  href="https://www.google.com/maps/place/InMotus/@20.635229,-103.382239,614m/data=!3m2!1e3!4b1!4m6!3m5!1s0x8428ad02770a943d:0x302eabe44ca182b2!8m2!3d20.635229!4d-103.382239!16s%2Fg%2F11z0vcbhyw?hl=es-419&entry=ttu"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-start gap-3 hover:text-blue-900 transition-colors group"
                >
                  <svg class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                  </svg>
                  <span class="text-sm leading-relaxed">C. Isla Tazmania 2036-Interior A,<br/>Jardines de La Cruz,<br/>44950 Guadalajara, Jal.</span>
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div class="mt-10 pt-8 border-t border-slate-200 text-center text-slate-500">
          <p class="text-sm">&copy; 2026 INMOTUS. Todos los derechos reservados.</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Inter";
  }

  body {
    font-family:
      "Inter",
      system-ui,
      -apple-system,
      sans-serif;
  }
</style>
